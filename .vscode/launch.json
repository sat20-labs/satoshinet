{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "satoshinet",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "cwd": "${workspaceFolder}",
            "buildFlags": "-gcflags='all=-N -l'",
            "env": {
            },
            "console": "integratedTerminal",
            "program": "${workspaceFolder}",
            "args": [
                "--homedir",
                "./data",
                "--txindex"
            ]
        },
        {
            "name": "Debug EVM network E2E",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/integration/evme2e",
            "buildFlags": "-tags=rpctest -mod=mod",
            "env": {
                "SATOSHINET_EVM_NETWORK_E2E": "1",
                "SATOSHINET_TEMPLATE_NETWORK_E2E": "1",
                 "SATOSHINET_POS_MINER_INTERVAL": "1",
                "SATOSHINET_POS_PREWARNING_INTERVAL": "1",
                "SATOSHINET_POS_CHECKING_INTERVAL": "1"
            },
            "args": [
                "-test.run", "^TestNetworkTemplateLimitOrderLargeBuyFilledBySmallSells$",
                "-test.count=1",
               // "-test.timeout=180s",
                "-test.v"
            ]
        },
        {
            "name": "Attach bootstrap node",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 23384
        },
        {
            "name": "satsnet_client",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "cwd": "${workspaceFolder}",
            "buildFlags": "-gcflags='all=-N -l'",
            "env": {
            },
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/satsnet_client",
            "args": [
                "--homedir",
                "/home/satsnet/data"
            ]
        },
    ]
}